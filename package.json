{
  "name": "kindpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv-run() { set -a; . ./.env; set +a; }; dotenv-run; DATABASE_URL=\"$ADMIN_DATABASE_URL\" prisma migrate dev",
    "db:deploy": "DATABASE_URL=\"$ADMIN_DATABASE_URL\" prisma migrate deploy",
    "db:rls": "docker exec -i kindpath-pg psql -U kindpath -d kindpath -v ON_ERROR_STOP=1 < prisma/sql/rls.sql",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^0.408.0",
    "next": "14.2.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  }
}
