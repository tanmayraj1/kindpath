# Runtime DB connection — app role (RLS enforced, non-superuser).
DATABASE_URL="postgresql://kindpath_app:app_dev_pw@localhost:5433/kindpath?schema=public"

# Admin DB connection — superuser, used ONLY for migrations + seeding.
ADMIN_DATABASE_URL="postgresql://kindpath:kindpath_dev_pw@localhost:5433/kindpath?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me"
AUTH_COOKIE="kindpath_session"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: "mock" (dev simulation) or "stripe" (real gateway; safe test mode with
# sk_test_ keys). Stripe keys: https://dashboard.stripe.com/test/apikeys — the webhook
# secret comes from the endpoint you register pointing at /api/webhooks/pos.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WeVend WePay gateway (PAYMENT_PROVIDER=wevend). Hosted-iframe gateway; per-merchant
# credentials. iframe base is country-specific (Canada: https://iframe.wevend.dev).
WEVEND_BASE_URL=""
WEVEND_IFRAME_URL="https://iframe.wevend.dev"
WEVEND_MID=""
WEVEND_EMAIL=""
WEVEND_PASSWORD=""
WEVEND_TERM_ID="00000003"

# Optional: distributed rate limiting (recommended on serverless/Vercel — in-memory
# is per-instance there). When unset, falls back to in-memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# In-dashboard AI assistant. Without a key it runs in deterministic "basic" mode
# (donor search, stats, receipts, lapsed). Add a key for natural-language chat.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-haiku-4-5-20251001"
