# Runtime DB connection — app role (RLS enforced, non-superuser).
DATABASE_URL="postgresql://kindpath_app:app_dev_pw@localhost:5433/kindpath?schema=public"

# Admin DB connection — superuser, used ONLY for migrations + seeding.
ADMIN_DATABASE_URL="postgresql://kindpath:kindpath_dev_pw@localhost:5433/kindpath?schema=public"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-me"
AUTH_COOKIE="kindpath_session"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments: "mock" (dev simulation) or "stripe" (real gateway; safe test mode with
# sk_test_ keys). Stripe keys: https://dashboard.stripe.com/test/apikeys — the webhook
# secret comes from the endpoint you register pointing at /api/webhooks/pos.
PAYMENT_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WeVend WePay gateway (PAYMENT_PROVIDER=wevend). Hosted-iframe gateway.
#   dev   API https://wepay.wevend.dev  · iframe (CA) https://iframe.wevend.dev
#   prod  API https://wepay.wevend.pro  · iframe (CA) https://iframe.wevend.pro
# Give the API ORIGIN only — a trailing "/api" is stripped, since their FAQ quotes
# the base with it and their endpoint tables quote paths that already include it.
# Auth is either ORG/ISV mode (WEVEND_WV_NUMBER + WEVEND_PASSWORD — one token acts
# across many merchant MIDs; MID passed per call) or MERCHANT mode (WEVEND_EMAIL +
# WEVEND_PASSWORD). WEVEND_MID = the merchant to transact as.
WEVEND_BASE_URL="https://wepay.wevend.dev"
WEVEND_IFRAME_URL="https://iframe.wevend.dev"
WEVEND_WV_NUMBER=""
WEVEND_EMAIL=""
WEVEND_PASSWORD=""
WEVEND_MID=""
WEVEND_TERM_ID="00000003"

# Optional: error monitoring. When set, server errors are forwarded to Sentry
# (no SDK — plain HTTP). When unset, errors are structured-logged to the console.
SENTRY_DSN=""

# REQUIRED IN PRODUCTION. Encrypts each org's gateway merchant credentials at
# rest. It falls back to AUTH_SECRET when unset, which couples credential
# decryption to session signing — rotating AUTH_SECRET would then destroy every
# org's stored gateway credentials. (Previously labelled "optional"; env.ts has
# always treated it as production-required.)
CREDENTIALS_KEY=""

# REQUIRED IN PRODUCTION. Signs cron requests. Without it /api/cron/* returns 401
# and every donor's recurring gift silently stops being collected.
CRON_SECRET=""

# Sender identity. Must be on the domain verified with Resend, or every send is
# rejected. The default falls back to an address you almost certainly don't own.
EMAIL_FROM="KindPath <receipts@example.org>"

# Printed on KindPath's own invoices to its customers. A Canadian supplier
# invoice without a GST/HST number is not a valid input-tax-credit document.
KINDPATH_GST_NUMBER=""

# REQUIRED ON VERCEL. Without these the rate limiter uses an in-memory Map, and
# each concurrent lambda gets its own — so the effective login limit becomes
# 10/min MULTIPLIED BY the instance count, and brute-force protection is
# effectively absent. Also covers 2FA, forgot-password, charges and webhooks.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# In-dashboard AI assistant. Without a key it runs in deterministic "basic" mode
# (donor search, stats, receipts, lapsed). Add a key for natural-language chat.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-haiku-4-5-20251001"
